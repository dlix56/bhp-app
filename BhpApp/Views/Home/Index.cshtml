@model IEnumerable<BhpApp.Models.Wypadek>

@{
    ViewData["Title"] = "Przekrój Kopalni";
}
<link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />

<style>

    body {
        background-color: #1a0f0a; 
        color: #e0e0e0;
    }

    .surface-building {
        background-color: #2c3e50; 
        border-bottom: 10px solid #27ae60; 
        box-shadow: 0 15px 20px rgba(0,0,0,0.6);
        position: relative;
        z-index: 5;
    }

    .main-shaft {
        background-color: #111;
        width: 120px;
        min-height: 700px;
        box-shadow: inset 0 0 25px black;
        border-left: 4px solid #333;
        border-right: 4px solid #333;
        position: relative;
    }

    .mining-level {
        background-color: #3e2723;
        border-top: 8px solid #2b1810;
        border-bottom: 12px solid #1f110b; 
        border-radius: 0 20px 20px 0;
        height: 160px;
        position: relative;
        cursor: crosshair;
        box-shadow: inset 0 15px 25px rgba(0,0,0,0.4); 
        transition: background-color 0.3s;
        background-image: repeating-linear-gradient(90deg, transparent, transparent 150px, #1a0b05 150px, #1a0b05 170px);
    }

        .mining-level:hover {
            background-color: #4a3028;
        }

        .mining-level::before {
            content: '';
            position: absolute;
            top: -8px;
            left: 0;
            right: 0;
            height: 30px;
            background-image: repeating-radial-gradient(circle at 75px 0, rgba(255, 235, 150, 0.15) 0%, transparent 40px);
            background-size: 170px 100%;
            pointer-events: none;
        }

    .elevator {
        width: 80%;
        height: 50px;
        background: repeating-linear-gradient(45deg, #f1c40f, #f1c40f 10px, #e67e22 10px, #e67e22 20px);
        margin: 0 auto;
        border-radius: 3px;
        border: 2px solid #000;
        box-shadow: 0 0 15px rgba(241, 196, 15, 0.4);
    }

    .dot-wypadek {
        transition: transform 0.2s, box-shadow 0.2s;
    }

        .dot-wypadek:hover {
            transform: translate(-50%, -50%) scale(1.5) !important;
            box-shadow: 0 0 15px currentColor !important;
        }
</style>

<div class="container-fluid mt-2">

    <div class="row surface-building p-4 rounded-top mb-0">
        <div class="col-md-8 d-flex flex-column justify-content-center">
            <h2 class="fw-bold mb-0 text-white">Centrala BHP - GCR</h2>
            <p class="text-light opacity-75 mb-0">System monitoringu podziemnego</p>
        </div>
        <div class="col-md-4 text-end">
            <div class="bg-dark p-3 rounded d-inline-block border border-secondary shadow"
                 style="cursor: pointer; transition: 0.3s;"
                 onmouseover="this.classList.add('bg-secondary')"
                 onmouseout="this.classList.remove('bg-secondary')"
                 data-bs-toggle="modal" data-bs-target="#podZiemiaModal">
                <span class="d-block text-muted small text-uppercase">Zalogowani pod ziemią <i class="bi bi-info-circle"></i></span>
                <span class="fs-3 fw-bold text-success">@ViewBag.PodZiemiaCount OSOB(Y)</span>
            </div>
        </div>
    </div>

    <div class="row g-0">

        <div class="col-auto">
            <div class="main-shaft d-flex flex-column align-items-center py-4 gap-5">
                <div class="text-secondary fw-bold rotate-90 fs-5 mt-4" style="writing-mode: vertical-rl; letter-spacing: 5px;">SZYB I</div>
                <div class="elevator mt-5"></div>
            </div>
        </div>

        <div class="col pe-4 py-4 d-flex flex-column justify-content-between" style="min-height: 700px;">

            <div class="mining-level p-3 d-flex flex-column justify-content-between">
                <div class="d-flex justify-content-between align-items-start z-1">
                    <h3 class="text-success fw-bold bg-dark bg-opacity-75 px-3 py-1 rounded border border-success">Poziom 300m</h3>
                </div>
                @foreach (var wyp in Model.Where(w => w.Strefa == "Poziom 300m"))
                {
                    <div class="position-absolute rounded-circle border border-2 border-dark shadow dot-wypadek @(wyp.Status == "Zatwierdzony" ? "bg-warning" : "bg-danger")"
                         style="width: 20px; height: 20px; left: @(wyp.WspolrzednaX)px; top: @(wyp.WspolrzednaY)px; transform: translate(-50%, -50%); cursor: pointer; z-index: 10;"
                         title="Zdarzenie: @wyp.Opis (Status: @wyp.Status)"
                         data-id="@wyp.Id" data-opis="@wyp.Opis">
                    </div>
                }
            </div>

            <div class="mining-level p-3 d-flex flex-column justify-content-between">
                <div class="d-flex justify-content-between align-items-start z-1">
                    <h3 class="text-warning fw-bold bg-dark bg-opacity-75 px-3 py-1 rounded border border-warning">Poziom 500m</h3>
                </div>
                @foreach (var wyp in Model.Where(w => w.Strefa == "Poziom 500m"))
                {
                    <div class="position-absolute rounded-circle border border-2 border-dark shadow dot-wypadek @(wyp.Status == "Zatwierdzony" ? "bg-warning" : "bg-danger")"
                         style="width: 20px; height: 20px; left: @(wyp.WspolrzednaX)px; top: @(wyp.WspolrzednaY)px; transform: translate(-50%, -50%); cursor: pointer; z-index: 10;"
                         title="Zdarzenie: @wyp.Opis (Status: @wyp.Status)"
                         data-id="@wyp.Id" data-opis="@wyp.Opis">
                    </div>
                }
            </div>

            <div class="mining-level p-3 d-flex flex-column justify-content-between">
                <div class="d-flex justify-content-between align-items-start z-1">
                    <h3 class="text-danger fw-bold bg-dark bg-opacity-75 px-3 py-1 rounded border border-danger">Poziom 800m</h3>
                </div>
                @foreach (var wyp in Model.Where(w => w.Strefa == "Poziom 800m"))
                {
                    <div class="position-absolute rounded-circle border border-2 border-dark shadow dot-wypadek @(wyp.Status == "Zatwierdzony" ? "bg-warning" : "bg-danger")"
                         style="width: 20px; height: 20px; left: @(wyp.WspolrzednaX)px; top: @(wyp.WspolrzednaY)px; transform: translate(-50%, -50%); cursor: pointer; z-index: 10;"
                         title="Zdarzenie: @wyp.Opis (Status: @wyp.Status)"
                         data-id="@wyp.Id" data-opis="@wyp.Opis">
                    </div>
                }
            </div>

        </div>
    </div>
</div>

@if (User.Identity != null && User.Identity.IsAuthenticated)
{
    <div class="modal fade text-dark" id="wypadekModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header bg-danger text-white">
                    <h5 class="modal-title fw-bold">⚠️ Zgłoś Zdarzenie / Wniosek</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <form id="wypadekForm" method="post" action="/Home/DodajWypadek">
                        <p class="mb-3">Strefa: <strong id="modalStrefa" class="text-danger"></strong></p>
                        <input type="hidden" id="WspolrzednaX" name="WspolrzednaX" />
                        <input type="hidden" id="WspolrzednaY" name="WspolrzednaY" />
                        <input type="hidden" id="Strefa" name="Strefa" />

                        <div class="mb-3">
                            <label class="form-label fw-bold">Krótki opis zdarzenia:</label>
                            <textarea class="form-control" name="Opis" rows="3" required></textarea>
                        </div>
                    </form>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Anuluj</button>
                    <button type="submit" form="wypadekForm" class="btn btn-danger">Wyślij zgłoszenie</button>
                </div>
            </div>
        </div>
    </div>
}
<div class="modal fade text-dark" id="podZiemiaModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-scrollable modal-lg">
        <div class="modal-content border-success border-3">
            <div class="modal-header bg-success text-white">
                <h5 class="modal-title fw-bold">👷 Lista osób pod ziemią</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-0">
                <ul class="list-group list-group-flush">
                    @if (ViewBag.PodZiemia != null)
                    {
                        foreach (var pracownik in ViewBag.PodZiemia)
                        {
                            <li class="list-group-item d-flex justify-content-between align-items-center">
                                <div>
                                    <strong>@pracownik.Imie @pracownik.Nazwisko</strong>
                                    <span class="text-muted small ms-2">(@pracownik.NumerPracownika)</span>
                                    @if (pracownik.CzyKierownikZespolu)
                                    {
                                        <span class="badge bg-warning text-dark ms-2">Sztygar</span>
                                    }
                                </div>
                                <span class="badge bg-dark">@pracownik.AktualnyPoziom</span>
                            </li>
                        }
                    }
                </ul>
            </div>
        </div>
    </div>
</div>

@if (User.IsInRole("AdminBHP"))
{
    <div class="modal fade text-dark" id="protokolModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-warning border-3">
                <div class="modal-header bg-warning text-dark">
                    <h5 class="modal-title fw-bold">📝 Sporządź Protokół</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <form id="protokolForm" method="post" action="/Home/ZatwierdzProtokol">
                        <input type="hidden" id="ProtokolWypadekId" name="WypadekId" />

                        <div class="alert alert-danger p-2 mb-3">
                            <small class="fw-bold">Treść zgłoszenia:</small><br />
                            <span id="ProtokolOpis"></span>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">Wybierz Poszkodowanego:</label>
                            <select class="form-select" name="PoszkodowanyId" required>
                                <option value="">-- Wybierz z bazy --</option>
                                @if (ViewBag.Pracownicy != null)
                                {
                                    foreach (var pracownik in ViewBag.Pracownicy)
                                    {
                                        <option value="@pracownik.Id">@pracownik.Nazwa</option>
                                    }
                                }
                            </select>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">Zmiana:</label>
                            <select class="form-select" name="Zmiana" required>
                                <option value="Ranna (6:00 - 14:00)">Ranna (6:00 - 14:00)</option>
                                <option value="Popołudniowa (14:00 - 22:00)">Popołudniowa (14:00 - 22:00)</option>
                                <option value="Nocna (22:00 - 6:00)">Nocna (22:00 - 6:00)</option>
                            </select>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">Data i godzina zdarzenia:</label>
                            <input type="datetime-local" class="form-control" name="DataWypadku" required />
                        </div>
                    </form>
                </div>
                <div class="modal-footer">
                    <button type="submit" form="protokolForm" class="btn btn-warning fw-bold text-dark w-100">Zatwierdź protokół</button>
                </div>
            </div>
        </div>
    </div>
}

@if (User.IsInRole("Pracownik"))
{
    <div class="modal fade text-dark" id="komentarzModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-info border-3">
                <div class="modal-header bg-info text-dark">
                    <h5 class="modal-title fw-bold">💬 Szczegóły i Uwagi</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <form id="komentarzForm" method="post" action="/Home/DodajKomentarz">
                        <input type="hidden" id="KomentarzWypadekId" name="WypadekId" />

                        <div class="alert alert-light border p-2 mb-3">
                            <small class="fw-bold text-muted">Opis z systemu:</small><br />
                            <span id="SzczegolyWypadkuOpis" class="fw-bold"></span>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">Twoje uwagi do protokołu:</label>
                            <textarea class="form-control" name="Komentarz" rows="3" required></textarea>
                        </div>
                    </form>
                </div>
                <div class="modal-footer">
                    <button type="submit" form="komentarzForm" class="btn btn-info fw-bold text-dark w-100">Zapisz komentarz</button>
                </div>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
    @if (User.Identity != null && User.Identity.IsAuthenticated)
    {
        <script>
            $(document).ready(function() {
                $('select[name="PoszkodowanyId"]').select2({
                    dropdownParent: $('#protokolModal'),
                    width: '100%'
                });
            });
            const wypadekModalEl = document.getElementById('wypadekModal');
            let wypadekModal = null;
            if (wypadekModalEl) {
                wypadekModal = new bootstrap.Modal(wypadekModalEl);
            }

            const korytarze = document.querySelectorAll('.mining-level');
            korytarze.forEach(korytarz => {
                korytarz.addEventListener('click', function (event) {
                    if (event.target.tagName === 'SPAN' || event.target.tagName === 'BUTTON' || event.target.tagName === 'H3' || event.target.tagName === 'DIV' && event.target.classList.contains('dot-wypadek')) {
                        return;
                    }

                    if (wypadekModal) {
                        const x = Math.round(event.offsetX);
                        const y = Math.round(event.offsetY);
                        const nazwaPoziomu = this.querySelector('h3').innerText;

                        document.getElementById('WspolrzednaX').value = x;
                        document.getElementById('WspolrzednaY').value = y;
                        document.getElementById('Strefa').value = nazwaPoziomu;
                        document.getElementById('modalStrefa').innerText = nazwaPoziomu;

                        wypadekModal.show();
                    }
                });
            });

            const kropki = document.querySelectorAll('.dot-wypadek');
            kropki.forEach(kropka => {
                kropka.addEventListener('click', function (event) {
                    event.stopPropagation(); // Ważne: blokuje klik w tło korytarza

                    const id = this.getAttribute('data-id');
                    const opis = this.getAttribute('data-opis');

                    const protokolModalEl = document.getElementById('protokolModal');
                    const komentarzModalEl = document.getElementById('komentarzModal');

                    if (protokolModalEl) {
                        document.getElementById('ProtokolWypadekId').value = id;
                        document.getElementById('ProtokolOpis').innerText = opis;
                        new bootstrap.Modal(protokolModalEl).show();
                    } else if (komentarzModalEl) {
                        document.getElementById('KomentarzWypadekId').value = id;
                        document.getElementById('SzczegolyWypadkuOpis').innerText = opis;
                        new bootstrap.Modal(komentarzModalEl).show();
                    }
                });
            });
        </script>
    }
}