@{
    ViewData["Title"] = "Przekrój Kopalni";
}

<style>
    /* Własne style CSS dla naszej kopalni */
    body {
        background-color: #1e1e1e; /* Ciemne tło dla całej strony (ziemia) */
        color: #f8f9fa;
    }

    .surface-building {
        background-color: #495057;
        border-bottom: 5px solid #28a745; /* Zielona linia oznaczająca poziom gruntu */
    }

    .main-shaft {
        background-color: #343a40;
        width: 100px;
        min-height: 600px;
        border-right: 2px dashed #6c757d;
        border-left: 2px dashed #6c757d;
    }

    .mining-level {
        background-color: #2b2b2b;
        border: 1px solid #444;
        border-radius: 0 10px 10px 0;
        height: 140px;
        position: relative; /* Bardzo ważne dla przyszłych czerwonych kropek z wypadkami! */
        transition: background-color 0.3s;
        cursor: crosshair; /* Zmienia kursor myszki na celownik */
    }

        .mining-level:hover {
            background-color: #383838; /* Lekkie podświetlenie korytarza po najechaniu myszką */
        }

    /* Imitacja "windy" w szybie */
    .elevator {
        width: 80%;
        height: 40px;
        background-color: #ffc107;
        margin: 0 auto;
        border-radius: 5px;
        box-shadow: 0 0 10px rgba(255, 193, 7, 0.5);
    }
</style>

<div class="container-fluid mt-3">

    <div class="row surface-building p-4 rounded-top shadow-sm mb-0">
        <div class="col-md-8 d-flex flex-column justify-content-center">
            <h2 class="fw-bold mb-0">Panel Dyspozytorski GCR-BHP</h2>
            <p class="text-light mb-0">Powierzchnia - Budynek Administracji</p>
        </div>
        <div class="col-md-4 text-end">
            <div class="bg-dark p-3 rounded d-inline-block">
                <span class="d-block text-muted small text-uppercase">Pracownicy pod ziemią</span>
                <span class="fs-3 fw-bold text-info">24</span>
            </div>
        </div>
    </div>

    <div class="row g-0">

        <div class="col-auto">
            <div class="main-shaft d-flex flex-column align-items-center py-4 gap-5">
                <div class="text-muted fw-bold rotate-90" style="writing-mode: vertical-rl;">SZYB GŁÓWNY</div>
                <div class="elevator mt-5"></div>
            </div>
        </div>

        <div class="col pe-4 py-4 d-flex flex-column justify-content-between" style="min-height: 600px;">

            <div class="mining-level p-3 d-flex flex-column justify-content-between shadow-sm">
                <div class="d-flex justify-content-between align-items-start">
                    <h3 class="text-success fw-bold border-bottom border-success pb-1">Poziom 300m</h3>
                    <span class="badge bg-secondary fs-6"><i class="bi bi-people-fill"></i> Załoga: 12</span>
                </div>
                <div class="d-flex justify-content-between align-items-end">
                    <span class="text-muted small">Kliknij w dowolne miejsce korytarza, aby wskazać współrzędne zdarzenia...</span>
                    <span class="badge bg-success bg-opacity-25 text-success border border-success">Ruch spokojny</span>
                </div>
            </div>

            <div class="mining-level p-3 d-flex flex-column justify-content-between shadow-sm">
                <div class="d-flex justify-content-between align-items-start">
                    <h3 class="text-warning fw-bold border-bottom border-warning pb-1">Poziom 500m</h3>
                    <span class="badge bg-secondary fs-6"><i class="bi bi-people-fill"></i> Załoga: 8</span>
                </div>
                <div class="d-flex justify-content-between align-items-end">
                    <span class="text-muted small">Kliknij w dowolne miejsce korytarza, aby wskazać współrzędne zdarzenia...</span>
                    <span class="badge bg-warning text-dark border border-warning">⚠️ Ściana do wyburzenia</span>
                </div>
            </div>

            <div class="mining-level p-3 d-flex flex-column justify-content-between shadow-sm">
                <div class="d-flex justify-content-between align-items-start">
                    <h3 class="text-danger fw-bold border-bottom border-danger pb-1">Poziom 800m</h3>
                    <span class="badge bg-secondary fs-6"><i class="bi bi-people-fill"></i> Załoga: 4</span>
                </div>
                <div class="d-flex justify-content-between align-items-end">
                    <span class="text-muted small">Kliknij w dowolne miejsce korytarza, aby wskazać współrzędne zdarzenia...</span>
                    <span class="badge bg-danger border border-danger">☣️ Zagrożenie: METAN</span>
                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <script>
        const korytarze = document.querySelectorAll('.mining-level');

        korytarze.forEach(korytarz => {
            korytarz.addEventListener('click', function (event) {

                if (event.target.tagName === 'SPAN' || event.target.tagName === 'BUTTON') {
                    return;
                }

                const x = Math.round(event.offsetX);
                const y = Math.round(event.offsetY);

                const nazwaPoziomu = this.querySelector('h3').innerText;

                alert(`[Zgłoszenie BHP]\nStrefa: ${nazwaPoziomu}\nWspółrzędne punktu wypadku:\nX: ${x}px, Y: ${y}px\n\nW kolejnym kroku otworzymy tu formularz zgłoszeniowy.`);
            });
        });
    </script>
}